    { "key": "lodging", "name": "Lodging", "group": "Nonresidential Buildings", "building": true, "saar": "TLLODGCONS", "nsa": "TLLODGCON", "private": "PLODGCONS" },
    { "key": "amuse", "name": "Amusement & Recreation", "group": "Nonresidential Buildings", "building": true, "saar": "TLAMUSCONS", "nsa": "TLAMUSCON", "private": "PRAMUSCONS", "public": "PBAMUSCONS" },
