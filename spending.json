    { "key": "nonres", "name": "Total Nonresidential (incl. infrastructure)", "group": "Totals", "saar": "TLNRESCONS", "nsa": "TLNRESCON", "private": "PNRESCONS", "public": "PBNRESCONS" },
    { "key": "health", "name": "Health Care", "group": "Nonresidential Buildings", "building": true, "saar": "TLHLTHCONS", "nsa": "TLHLTHCON", "private": "PRHLTHCONS", "public": "PBHLTHCONS" },
    { "key": "edu", "name": "Educational", "group": "Nonresidential Buildings", "building": true, "saar": "TLEDUCONS", "nsa": "TLEDUCON", "private": "PREDUCONS", "public": "PBEDUCONS" },
    { "key": "office", "name": "Office (incl. data centers)", "group": "Nonresidential Buildings", "building": true, "saar": "TLOFCONS", "nsa": "TLOFCON", "private": "PROFCONS", "public": "PBOFCONS" },
    { "key": "mfg", "name": "Manufacturing", "group": "Nonresidential Buildings", "building": true, "saar": "TLMFGCONS", "nsa": "TLMFGCON", "private": "PRMFGCONS" },
    { "key": "safety", "name": "Public Safety", "group": "Nonresidential Buildings", "building": true, "saar": "TLPSCONS", "nsa": "TLPSCON", "public": "PBPSCONS" },
